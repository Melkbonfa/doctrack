# DocTrack v3.5 - variáveis de ambiente
# ========================================

# OBRIGATÓRIO: Chave para assinar tokens JWT (use string aleatória de >=32 chars)
JWT_SECRET=minha-chave-secreta-32-caracteres-jwt-token

# Opcional: origens permitidas para CORS, separadas por virgula
CORS_ORIGINS=*

# Opcional: raizes permitidas para visualizar/baixar arquivos dos equipamentos (separadas por ';').
# Prefira a forma UNC (\\servidor\compartilhamento\...) para funcionar quando o servidor
# roda como servico Windows, pois servicos nao enxergam drives mapeados (P:, Z:, ...).
# DOCTRACK_FILE_ROOTS=\\loccus-srv03\Projetos$\Engenharia;P:\Engenharia

# Banco de dados:
# - Local (SQLite): deixe vazio (usa doctrack.db automaticamente)
# - Produção (PostgreSQL): Render injeta automaticamente
# DATABASE_URL=postgresql://user:pass@host:5432/doctrack
