# Variaveis de ambiente
.env
.env.local
.env.*.local

# Backups e arquivos temporarios
*.bak
*-bak
*.db.backup-*
backups/

# Arquivos enviados pelos usuarios para a plataforma (DOCTRACK_ARQUIVOS).
# Padrao = <raiz>/arquivos, ou seja, DENTRO do checkout em desenvolvimento.
# Sao dados, nao codigo — e podem conter documentos internos.
arquivos/

# Logs do servico (NSSM redireciona stdout/stderr para ca)
logs/

# Instaladores / binarios grandes
*.exe
tools/

# Artefatos de build do PyInstaller
build/
dist/

# Database local
doctrack.db
doctrack.db.bak-*
*.db-journal

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Node
node_modules/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Agent configs (não necessário em produção)
.agent/
.claude/
.superpowers/

# Grafo de conhecimento gerado pelo graphify (~9,6 MB, regenerável)
graphify-out/

# Material local que NAO vai para o repositorio (publico): documentos oficiais,
# material de apresentacao e configuracao local do assistente.
docs/oficiais/
docs/ROTEIRO_APRESENTACAO.md
docs/NARRACAO.md
docs/s[0-9][0-9].mp3
.agents/
skills-lock.json
